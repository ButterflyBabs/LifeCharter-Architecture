{
  "crons": [
    {
      "path": "/api/cron/followups",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/masterclass-recording",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/masterclass-zoom-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/community-notify",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/weekly-offer-thread",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/journal-reminders",
      "schedule": "0 15 * * 1,5"
    },
    {
      "path": "/api/cron/journal-review",
      "schedule": "0 22 * * 0"
    }
  ],
  "rewrites": [
    {
      "source": "/executive_consultation",
      "destination": "https://lccs-lifecharter-booking.vercel.app"
    },
    {
      "source": "/executive_consultation/:path*",
      "destination": "https://lccs-lifecharter-booking.vercel.app/:path*"
    }
  ]
}
