{
  "crons": [
    {
      "path": "/api/cron/followups",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/masterclass-recording",
      "schedule": "0 15 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/executive_consultation",
      "destination": "https://lccs-lifecharter-booking.vercel.app"
    },
    {
      "source": "/executive_consultation/:path*",
      "destination": "https://lccs-lifecharter-booking.vercel.app/:path*"
    }
  ]
}
